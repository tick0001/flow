# Annuaire de developpement.
#
# Deux branches, deux groupes, deux comptes : le minimum pour que la question
# interessante ait un sens -- « Exploitation » recoit un profil sur une entite,
# « Lecture » un autre, et l'on verifie que chacun herite de ce que sa regle dit.
#
# Les mots de passe sont en clair et dans le depot : cet annuaire n'existe que
# sur la machine de developpement, au meme titre que « flow/flow » pour
# PostgreSQL. Aucune installation reelle ne le demarre.

dn: ou=personnes,dc=flow,dc=test
objectClass: organizationalUnit
ou: personnes

dn: ou=groupes,dc=flow,dc=test
objectClass: organizationalUnit
ou: groupes

dn: uid=a.dupont,ou=personnes,dc=flow,dc=test
objectClass: inetOrgPerson
objectClass: top
uid: a.dupont
cn: Amelie Dupont
sn: Dupont
givenName: Amelie
mail: a.dupont@flow.test
userPassword: annuaire-dupont

