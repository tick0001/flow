# Configuration d'une installation Flow&.
#
# A copier en `.env` a cote de `compose.production.yaml`, puis a remplir. Aucune
# de ces valeurs n'a de defaut : une valeur par defaut pour un secret serait la
# meme sur toutes les installations du monde, et la plupart ne la changeraient
# jamais.
#
# Voir docs/23-installation.md pour la marche a suivre complete.

# --- Base de donnees ---------------------------------------------------------
# Le role proprietaire : il possede les tables, joue les migrations et amorce
# l'installation. L'application ne s'en sert pas pour son trafic courant.
POSTGRES_USER=flow
POSTGRES_PASSWORD=
POSTGRES_DB=flow

# La meme base, vue par les services. L'hote est le nom du service Compose.
DATABASE_URL=postgres://flow:CHANGEZ_MOI@postgres:5432/flow

# **Le role applicatif, et son mot de passe a changer.**
#
# `flow_app` est cree par la premiere migration avec un mot de passe public --
# il est ecrit dans le depot. Le changer fait partie de l'installation, et le
# guide en donne la commande. Tant qu'il n'est pas change, quiconque a lu le
# depot et peut joindre la base peut lire toutes les donnees de toutes les
# entites : ce role est soumis au Row-Level Security, pas au secret.
DATABASE_APP_URL=postgres://flow_app:CHANGEZ_MOI_AUSSI@postgres:5432/flow

# --- Redis -------------------------------------------------------------------
# REDIS_URL=redis://redis:6379

# --- Secrets -----------------------------------------------------------------
# Signature des cookies de session. Au moins seize caracteres.
#   openssl rand -base64 48
SESSION_SECRET=

# Chiffrement des secrets stockes en base. **Exactement 64 caracteres
# hexadecimaux.** La perdre rend illisibles les mots de passe de comptes de
# service et les clefs deja emises -- elle se sauvegarde avec la base.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# --- Adresses ----------------------------------------------------------------
# Ce que le navigateur voit. L'interface et l'API partagent la meme origine :
# nginx relaie `/api` vers le conteneur de l'API.
API_URL=https://flow.exemple.fr
WEB_URL=https://flow.exemple.fr

# Cookie de session reserve a HTTPS. A ne passer a false que pour une
# installation d'essai en HTTP sur la boucle locale.
COOKIE_SECURE=true

# --- Publication ----------------------------------------------------------
# L'interface n'ecoute que sur la boucle locale : un relais TLS -- nginx,
# Caddy, Traefik -- se place devant. Pour exposer directement, mettre 0.0.0.0,
# en sachant que le trafic sera alors en clair.
FLOW_WEB_BIND=127.0.0.1
FLOW_WEB_PORT=8080

# --- Reglages ----------------------------------------------------------------
# Executions simultanees par worker. Chacune ouvre un navigateur : compter
# environ un gigaoctet de memoire et un coeur par execution.
WORKER_CONCURRENCY=2

# DEFAULT_LOCALE=fr
# LOG_LEVEL=log

# --- Images ------------------------------------------------------------------
# Epingler une version plutot que `latest` : une montee de version doit se
# decider, pas survenir au prochain redemarrage.
# FLOW_IMAGE_API=ghcr.io/tick-and/flow-api:0.1.0
# FLOW_IMAGE_WORKER=ghcr.io/tick-and/flow-worker:0.1.0
# FLOW_IMAGE_WEB=ghcr.io/tick-and/flow-web:0.1.0
# FLOW_IMAGE_MIGRATIONS=ghcr.io/tick-and/flow-migrations:0.1.0
