<?xml version="1.0" encoding="UTF-8"?>
<!--
  Flow& derriere IIS, hors conteneurs.

  A poser a la racine du site, qui pointe sur apps\web\dist.

  **Deux modules sont requis**, et ne sont pas installes par defaut :
    - URL Rewrite   (https://www.iis.net/downloads/microsoft/url-rewrite)
    - Application Request Routing, avec le relais active dans la configuration
      du serveur (https://www.iis.net/downloads/microsoft/application-request-routing)

  Sans ARR, la regle de relais vers l'API rend une 500 dont le message ne dit
  pas qu'il manque un module -- c'est le premier endroit ou regarder.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- L'API d'abord : une regle plus loin renverrait /api vers
             index.html, et l'interface recevrait du HTML la ou elle attend du
             JSON. Le symptome serait « Unexpected token < in JSON ». -->
        <rule name="API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3100/api/{R:1}" />
        </rule>

        <!-- Application a page unique : toute adresse qui ne designe pas un
             fichier existant rend index.html, et c'est le routeur du
             navigateur qui decide. Sans cela, un rechargement sur
             /executions/<id> donnerait un 404 d'IIS. -->
        <rule name="Interface" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Le flux d'evenements du serveur ne doit pas etre tamponne : le retenir
         jusqu'a ce que le tampon soit plein reviendrait a l'afficher a la fin
         de l'execution. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <caching enabled="true" enableKernelCache="false" />

    <staticContent>
      <!-- Les fichiers construits portent une empreinte dans leur nom : ils ne
           changent jamais de contenu. `index.html`, lui, ne doit jamais etre
           garde -- c'est lui qui nomme les empreintes. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>

  <!-- `location` est un enfant de `configuration`, jamais de `system.webServer` :
       place a l'interieur, IIS refuse le fichier entier avec une erreur de
       configuration qui ne designe pas la ligne fautive. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
