{
  "name": "@flow/api",
  "license": "AGPL-3.0-or-later",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "db:init": "tsc -p tsconfig.build.json && node dist/cli/initialiser.js",
    "db:seed": "tsc -p tsconfig.build.json && node dist/cli/seed.js",
    "openapi": "tsc -p tsconfig.build.json && node dist/cli/openapi.js"
  },
  "dependencies": {
    "@flow/contracts": "workspace:*",
    "@flow/db": "workspace:*",
    "@flow/i18n": "workspace:*",
    "@flow/plugin-sdk": "workspace:*",
    "@flow/storage": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.15",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flow/bot-sdk": "workspace:*",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
